{
  "name": "@pickle-spec/configuration",
  "version": "1.0.2",
  "description": "Configuration schemas and validation for Pickle Spec",
  "homepage": "https://github.com/victor-teles/pickle-spec#readme",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/victor-teles/pickle-spec.git",
    "directory": "packages/configuration"
  },
  "files": [
    "lib"
  ],
  "type": "module",
  "exports": {
    ".": "./lib/index.js"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "bunx --bun vitest run --configLoader runner --experimental.viteModuleRunner=false --experimental.nodeLoader=false --config ../../vitest.package.config.ts",
    "build": "bun ../../scripts/build-package.ts",
    "prepack": "bun run build"
  },
  "dependencies": {
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/bun": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "engines": {
    "node": ">=24.0.0"
  }
}
