{
  "name": "@pickle-spec/runner",
  "version": "1.0.2",
  "files": [
    "benchmarking.ts",
    "index.ts",
    "testing.ts",
    "src/**/*.ts"
  ],
  "type": "module",
  "exports": {
    ".": "./index.ts",
    "./benchmarking": "./benchmarking.ts",
    "./testing": "./testing.ts"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "bunx --bun vitest run --configLoader runner --experimental.viteModuleRunner=false --experimental.nodeLoader=false --config ../../vitest.package.config.ts"
  },
  "dependencies": {
    "@pickle-spec/configuration": "workspace:*",
    "@pickle-spec/spec": "workspace:*",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/bun": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "peerDependencies": {
    "vitest": "^5.0.0"
  }
}
