{
  "name": "@pickle-spec/runner",
  "version": "1.0.2",
  "type": "module",
  "exports": {
    ".": "./index.ts",
    "./benchmarking": "./benchmarking.ts",
    "./testing": "./testing.ts"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "benchmarking.ts",
    "index.ts",
    "testing.ts",
    "src/*.ts",
    "!src/*.test.ts"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "bun test"
  },
  "dependencies": {
    "@pickle-spec/spec": "workspace:*",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/bun": "catalog:",
    "typescript": "catalog:"
  }
}
