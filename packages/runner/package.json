{
  "name": "@pickle-spec/runner",
  "version": "1.0.2",
  "description": "Scheduling, execution, Replay, and test evidence for Pickle Spec",
  "homepage": "https://github.com/victor-teles/pickle-spec#readme",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/victor-teles/pickle-spec.git",
    "directory": "packages/runner"
  },
  "files": [
    "lib"
  ],
  "type": "module",
  "exports": {
    ".": "./lib/index.js",
    "./benchmarking": "./lib/benchmarking.js",
    "./testing": "./lib/testing.js",
    "./schemas": "./lib/schemas.js"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "bunx --bun vitest run --configLoader runner --experimental.viteModuleRunner=false --experimental.nodeLoader=false --config ../../vitest.package.config.ts",
    "build": "bun ../../scripts/build-package.ts",
    "prepack": "bun run build"
  },
  "dependencies": {
    "@pickle-spec/configuration": "workspace:*",
    "@pickle-spec/spec": "workspace:*",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/bun": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "peerDependencies": {
    "vitest": "^5.0.0"
  },
  "engines": {
    "node": ">=24.0.0"
  }
}
