{
  "name": "@pickle-spec/studio",
  "version": "1.0.2",
  "type": "module",
  "exports": {
    ".": "./index.ts"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist",
    "index.ts",
    "src",
    "!src/**/*.test.ts",
    "!src/**/*.test.tsx"
  ],
  "scripts": {
    "build": "NODE_ENV=production rsbuild build",
    "prepack": "bun run build",
    "typecheck": "tsc --noEmit",
    "test": "bun run build && bunx --bun vitest run --configLoader runner --experimental.viteModuleRunner=false --experimental.nodeLoader=false --config ../../vitest.package.config.ts"
  },
  "dependencies": {
    "@base-ui/react": "^1.0.0",
    "@fontsource-variable/eb-garamond": "^5.3.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@hugeicons/core-free-icons": "^4.2.3",
    "@hugeicons/react": "^1.1.9",
    "@pickle-spec/runner": "workspace:*",
    "@pickle-spec/spec": "workspace:*",
    "@tanstack/react-router": "1.170.32",
    "@tanstack/react-start": "1.168.49",
    "@types/bun": "catalog:",
    "@typescript/typescript6": "catalog:",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "monaco-editor": "^0.56.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "srvx": "^0.12.7",
    "tailwind-merge": "^3.3.1",
    "tailwindcss": "^4.1.12",
    "tw-animate-css": "^1.3.8"
  },
  "devDependencies": {
    "@rsbuild/core": "^2.2.1",
    "@rsbuild/plugin-react": "^2.1.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
