{
  "name": "@pickle-spec/cli",
  "version": "1.0.2",
  "type": "module",
  "bin": {
    "pickle": "./src/cli.ts"
  },
  "exports": {
    ".": "./index.ts"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "index.ts",
    "src/**/*.ts"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "bun run test:unit",
    "test:unit": "bunx --bun vitest run --configLoader runner --experimental.viteModuleRunner=false --experimental.nodeLoader=false --config vitest.config.ts",
    "test:integration": "bun run test:integration:confidentiality && bun run test:integration:main",
    "test:integration:confidentiality": "bunx --bun vitest run --configLoader runner --experimental.viteModuleRunner=false --experimental.nodeLoader=false --config vitest.integration.config.ts tests/integration/execution-cache/execution-cache-confidentiality.test.ts",
    "test:integration:main": "bunx --bun vitest run --configLoader runner --experimental.viteModuleRunner=false --experimental.nodeLoader=false --config vitest.integration.config.ts --exclude '**/execution-cache-confidentiality.test.ts'",
    "test:e2e": "bunx --bun vitest run --configLoader runner --experimental.viteModuleRunner=false --experimental.nodeLoader=false --config vitest.e2e.config.ts",
    "test:all": "bun run test:unit && bun run test:integration && bun run test:e2e"
  },
  "dependencies": {
    "@pickle-spec/configuration": "workspace:*",
    "@pickle-spec/mobile": "workspace:*",
    "@pickle-spec/runner": "workspace:*",
    "@pickle-spec/spec": "workspace:*",
    "@pickle-spec/studio": "workspace:*",
    "@pickle-spec/web": "workspace:*",
    "@types/bun": "catalog:",
    "@typescript/typescript6": "catalog:",
    "commander": "^15.0.0",
    "ora": "8",
    "picocolors": "^1.1.1",
    "prompts": "^2.4.2",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@types/prompts": "^2.4.9",
    "playwright": "^1.55.0",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
