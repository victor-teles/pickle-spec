{
  "name": "@pickle-spec/cli",
  "version": "1.0.2",
  "type": "module",
  "bin": {
    "pickle": "./src/cli.ts"
  },
  "exports": {
    ".": "./index.ts"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "index.ts",
    "src/**/*.ts",
    "!src/**/*.test.ts"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "bun run test:confidentiality && bun run test:remaining",
    "test:confidentiality": "bun test --preload ./test/test-environment.ts --max-concurrency 1 src/execution-cache/execution-cache-confidentiality.test.ts",
    "test:remaining": "bun test --preload ./test/test-environment.ts --max-concurrency 1 --path-ignore-patterns '**/execution-cache-confidentiality.test.ts'"
  },
  "dependencies": {
    "@pickle-spec/configuration": "workspace:*",
    "@pickle-spec/mobile": "workspace:*",
    "@pickle-spec/runner": "workspace:*",
    "@pickle-spec/spec": "workspace:*",
    "@pickle-spec/studio": "workspace:*",
    "@pickle-spec/web": "workspace:*",
    "@types/bun": "catalog:",
    "@typescript/typescript6": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "playwright": "^1.55.0",
    "typescript": "catalog:"
  }
}
