{
  "name": "@pickle-spec/web",
  "version": "1.0.2",
  "description": "Stagehand web execution adapter for Pickle Spec",
  "homepage": "https://github.com/victor-teles/pickle-spec#readme",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/victor-teles/pickle-spec.git",
    "directory": "packages/web"
  },
  "files": [
    "index.ts",
    "src/**/*.ts"
  ],
  "type": "module",
  "exports": {
    ".": "./index.ts"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "benchmark:replay": "bun src/benchmarking/web-benchmark-cli.ts",
    "typecheck": "tsc --noEmit",
    "test": "bun run test:unit",
    "test:unit": "bunx --bun vitest run --configLoader runner --experimental.viteModuleRunner=false --experimental.nodeLoader=false --config ../../vitest.package.config.ts",
    "test:integration": "bunx --bun vitest run --configLoader runner --experimental.viteModuleRunner=false --experimental.nodeLoader=false --config ../../vitest.integration.config.ts"
  },
  "dependencies": {
    "@browserbasehq/stagehand": "catalog:",
    "@pickle-spec/configuration": "workspace:*",
    "@pickle-spec/runner": "workspace:*",
    "@pickle-spec/spec": "workspace:*",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/bun": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:",
    "vitest-mock-extended": "catalog:"
  },
  "engines": {
    "bun": ">=1.4.2"
  }
}
