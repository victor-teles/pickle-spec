{
  "name": "pickle-spec-monorepo",
  "private": true,
  "workspaces": {
    "packages": [
      "apps/*",
      "packages/*"
    ],
    "catalog": {
      "@biomejs/biome": "2.5.8",
      "@browserbasehq/stagehand": "^4.0.1",
      "@cucumber/gherkin": "^29.0.0",
      "@cucumber/messages": "^26.0.1",
      "@types/bun": "latest",
      "@typescript/typescript6": "^6.0.2",
      "turbo": "^2.8.1",
      "typescript": "^7.0.2",
      "zod": "^4"
    }
  },
  "scripts": {
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "lint": "biome check .",
    "format": "biome check --write .",
    "run:example": "turbo run run:example --filter=@pickle-spec/example"
  },
  "devDependencies": {
    "@biomejs/biome": "catalog:",
    "@types/bun": "catalog:",
    "turbo": "catalog:",
    "typescript": "catalog:"
  },
  "packageManager": "bun@1.3.11"
}
