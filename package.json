{
  "name": "pickle-spec-monorepo",
  "private": true,
  "workspaces": {
    "packages": [
      "apps/*",
      "packages/*"
    ],
    "catalog": {
      "@biomejs/biome": "2.5.8",
      "@browserbasehq/stagehand": "^4.0.1",
      "@cucumber/gherkin": "^29.0.0",
      "@cucumber/messages": "^26.0.1",
      "@types/bun": "latest",
      "@typescript/typescript6": "^6.0.2",
      "agent-device": "^0.20.10",
      "turbo": "^2.8.1",
      "typescript": "^7.0.2",
      "vitest": "4.1.11",
      "vitest-mock-extended": "5.1.1",
      "zod": "^4"
    }
  },
  "scripts": {
    "typecheck": "turbo run typecheck",
    "test": "bun scripts/verify-vitest-migration.ts && bunx --bun vitest run --configLoader runner --experimental.viteModuleRunner=false --experimental.nodeLoader=false --config vitest.scripts.config.ts && turbo run test",
    "lint": "biome check .",
    "format": "biome check --write .",
    "benchmark:replay": "bun scripts/replay-performance-gate.ts",
    "docs": "turbo run dev --filter=@pickle-spec/docs",
    "docs:build": "turbo run build --filter=@pickle-spec/docs",
    "release:check": "bun scripts/release-packages.ts validate",
    "run:example": "turbo run run:example --filter=@pickle-spec/example",
    "studio": "turbo run studio --filter=@pickle-spec/example"
  },
  "devDependencies": {
    "@biomejs/biome": "catalog:",
    "@types/bun": "catalog:",
    "turbo": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "packageManager": "bun@1.3.11"
}
