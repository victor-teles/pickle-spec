{
  "$schema": "https://turbo.build/schema.json",
  "globalPassThroughEnv": ["PICKLE_HOME", "PICKLE_CACHE_ROOT"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": [".next/**", "!.next/cache/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "typecheck": {
      "dependsOn": ["^typecheck"]
    },
    "test": {},
    "run:example": {
      "cache": false,
      "persistent": false
    },
    "studio": {
      "cache": false,
      "persistent": false
    }
  }
}
