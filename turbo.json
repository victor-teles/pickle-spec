{
  "$schema": "https://turbo.build/schema.json",
  "globalPassThroughEnv": ["PICKLE_HOME", "PICKLE_CACHE_ROOT"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": [".next/**", "!.next/cache/**", "dist/**", "lib/**"],
      "inputs": ["$TURBO_DEFAULT$", "!tests/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "typecheck": {
      "dependsOn": ["^build", "^typecheck"]
    },
    "test": {
      "dependsOn": ["^build"]
    },
    "run:example": {
      "cache": false,
      "persistent": false
    },
    "studio": {
      "dependsOn": ["^build"],
      "cache": false,
      "persistent": true
    }
  },
  "globalDependencies": ["scripts/build-package.ts", "tsconfig.json"]
}
