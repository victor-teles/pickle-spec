{
  "schemaVersion": 1,
  "specifications": "features/**/*.feature",
  "suites": {
    "smoke": {
      "tagExpression": "@smoke",
      "states": ["active"]
    }
  },
  "links": {
    "automation-exercise": "https://automationexercise.com/test_cases#collapse{id}"
  },
  "executionTargetProfile": {
    "id": "web"
  },
  "web": {
    "baseUrl": "https://automationexercise.com",
    "browser": {
      "environment": "local",
      "modelName": "google/gemini-3.6-flash",
      "headless": true
    }
  },
  "execution": {
    "scenarioTimeoutMs": 120000,
    "stepTimeoutMs": 30000
  },
  "concurrency": 1
}
