{
  "schemaVersion": 1,
  "specifications": "features/**/*.feature",
  "suites": {
    "smoke": {
      "tagExpression": "@smoke",
      "states": ["active"]
    },
    "regression": {
      "tagExpression": "@regression",
      "states": ["active"]
    }
  },
  "executionTargetProfile": {
    "id": "web"
  },
  "web": {
    "baseUrl": "https://www.saucedemo.com",
    "browser": {
      "environment": "local",
      "modelName": "google/gemini-3.6-flash",
      "headless": false
    }
  },
  "execution": {
    "scenarioTimeoutMs": 120000,
    "stepTimeoutMs": 30000
  },
  "applicationRevision": "saucedemo-current",
  "concurrency": 1
}
