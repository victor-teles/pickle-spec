{
  "schemaVersion": 1,
  "specifications": "features/**/*.feature",
  "suites": {
    "smoke": {
      "tagExpression": "@smoke",
      "states": ["active"]
    }
  },
  "executionTargetProfile": {
    "id": "ios"
  },
  "executionTargetProfiles": {
    "ios": {
      "adapter": "mobile",
      "mobile": {
        "executionTarget": "ios-simulator",
        "application": {
          "id": "com.example.app",
          "binaryPath": "/absolute/path/to/YourApp.app"
        },
        "artifactDirectory": ".pickle/artifacts",
        "artifacts": ["screenshot", "device-log"]
      }
    }
  },
  "execution": {
    "scenarioTimeoutMs": 120000,
    "stepTimeoutMs": 30000
  },
  "applicationRevision": "ios-example-local",
  "concurrency": 1
}
