{
  "$schema": "https://biomejs.dev/schemas/2.5.8/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "ignoreUnknown": true,
    "includes": ["**", "!**/bun.lock"]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "style": {
        "noUselessElse": "error",
        "noNestedTernary": "error",

        "noParameterAssign": {
          "level": "error",
          "options": {
            "propertyAssignment": "deny"
          }
        },

        "noNonNullAssertion": "error",

        "noExcessiveLinesPerFile": {
          "level": "warn",
          "options": {
            "maxLines": 350,
            "skipBlankLines": true
          }
        },

        "noExcessiveClassesPerFile": {
          "level": "error",
          "options": {
            "maxClasses": 1
          }
        },
        "useNamingConvention": {
          "level": "error",
          "options": {
            "conventions": [
              {
                "selector": { "kind": "variable" },
                "formats": ["camelCase"]
              },
              {
                "selector": { "kind": "objectLiteralMember" },
                "formats": ["camelCase", "CONSTANT_CASE", "PascalCase"]
              }
            ]
          }
        }
      },
      "complexity": {
        "noUselessUndefined": "error",
        "noExcessiveCognitiveComplexity": {
          "level": "error",
          "options": { "maxAllowedComplexity": 10 }
        },
        "noExcessiveLinesPerFunction": {
          "level": "error",
          "options": {
            "maxLines": 50,
            "skipBlankLines": true
          }
        }
      },
      "suspicious": {
        "noExplicitAny": "error",
        "noShadow": "error"
      }
    }
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "single",
      "semicolons": "asNeeded"
    }
  },
  "overrides": [
    {
      "includes": ["**/*.test.ts", "**/*.test.tsx", "**/test/**"],
      "linter": {
        "rules": {
          "complexity": {
            "noExcessiveLinesPerFunction": "off"
          }
        }
      }
    }
  ],
  "css": {
    "parser": {
      "tailwindDirectives": true
    }
  },
  "assist": {
    "enabled": true,
    "actions": {
      "source": {
        "organizeImports": "on"
      }
    }
  }
}
